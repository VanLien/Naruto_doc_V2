Config.UnitData1.data_unit2_length = 15120
Config.UnitData1.data_unit2_cache = {}
Config.UnitData1.data_unit2 = function(key)
	if Config.UnitData1.data_unit2_cache[key] == nil then
		local base = Config.UnitData1.data_unit2_table[key]
		if not base then return end
		base = loadstring(string.format('return %s',base))()
		if not base then return end
		Config.UnitData1.data_unit2_cache[key] = {
			bid = base[1],
			name = base[2],
			career = base[3],
			camp_type = base[4],
			sex = base[5],
			lev = base[6],
			sub_type = base[7],
			body_id = base[8],
			weapon_res = base[9],
			awake_res = base[10],
			talk = base[11],
			model_size = base[12],
			head_icon = base[13],
			partial = base[14],
			rare_type = base[15],
			star = base[16],
			unit_is_boss = base[17],
			fight_effect = base[18],
		}
	end
	return Config.UnitData1.data_unit2_cache[key] 
end
