function ForgeCraftData:getConst(key)
    return self.Const and self.Const[key]
end

function ForgeCraftData:getExplainDesc()
    return self.Const and self.Const.explain_desc or ""
end

function ForgeCraftData:getTabName(tab_id)
    return self.TabName and self.TabName[tab_id]
end

function ForgeCraftData:getRecipe(bid)
    return self.Recipe and self.Recipe[bid]
end

function ForgeCraftData:getRecipeList()
    local list = {}
    for _, data in pairs(self.Recipe or {}) do
        table.insert(list, data)
    end
    table.sort(list, function(a, b)
        local order_a = a.order or a.bid or 0
        local order_b = b.order or b.bid or 0
        if order_a == order_b then
            return (a.bid or 0) < (b.bid or 0)
        end
        return order_a < order_b
    end)
    return list
end

function ForgeCraftData:getRecipeListByTab(tab)
    local list = {}
    for _, data in pairs(self.Recipe or {}) do
        if data.tab == tab then
            table.insert(list, data)
        end
    end
    table.sort(list, function(a, b)
        local order_a = a.order or a.bid or 0
        local order_b = b.order or b.bid or 0
        if order_a == order_b then
            return (a.bid or 0) < (b.bid or 0)
        end
        return order_a < order_b
    end)
    return list
end

function ForgeCraftData:getRecipeResultPool(recipe_bid)
    local recipe = self:getRecipe(recipe_bid)
    return recipe and recipe.result_pool or {}
end

return ForgeCraftData
