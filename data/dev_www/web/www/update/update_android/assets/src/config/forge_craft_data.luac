--------------------------------------------
-- ForgeHouse - Craft data
-- Path:
-- src/config/forge_craft_data.luac
--
-- Mục đích:
-- 1. Gom toàn bộ text mô tả / thông báo client về 1 chỗ
-- 2. Gom toàn bộ recipe tab Chế Tạo về 1 chỗ
-- 3. Gom cả result_pool để vùng 76%% / 20%% / 4%% hiển thị item preview
--------------------------------------------

Config = Config or {}
Config.ForgeCraftData = Config.ForgeCraftData or {}
ForgeCraftData = Config.ForgeCraftData
local ForgeCraftData = Config.ForgeCraftData

local function buildRecipe(bid, name, lev, need_items, loss, order, tab, result_pool, show_in_forgehouse)
    return {
        bid = bid,
        name = name,
        lev = lev or 1,
        need_items = need_items or {},
        loss = loss or {},
        order = order or bid,
        tab = tab,
        result_pool = result_pool or {},
        show_in_forgehouse = show_in_forgehouse == nil and 1 or show_in_forgehouse
    }
end

local function buildExplainDesc()
    return TI18N(
        "<div fontcolor=#fff4d2 fontsize=24 outline=2,#3a1b00>Quy tắc Chế Tạo</div>"
        .. "\n<div fontcolor=#ffd45c>• </div><div fontcolor=#ffffff>Chọn món trang bị muốn chế tạo ở danh sách bên dưới.</div>"
        .. "\n<div fontcolor=#ffd45c>• </div><div fontcolor=#ffffff>Chuẩn bị đủ </div><div fontcolor=#7CFF7A>nguyên liệu</div><div fontcolor=#ffffff> và </div><div fontcolor=#7CFF7A>vàng</div><div fontcolor=#ffffff>. Nếu thiếu, số lượng sẽ hiển thị </div><div fontcolor=#ff6b6b>màu đỏ</div><div fontcolor=#ffffff>.</div>"
        .. "\n<div fontcolor=#ffd45c>• </div><div fontcolor=#ffffff>Nhấn </div><div fontcolor=#ffe48a>Tạo</div><div fontcolor=#ffffff> để tiêu hao nguyên liệu và nhận </div><div fontcolor=#89d8ff>1 trang bị</div><div fontcolor=#ffffff> theo tỉ lệ hiển thị ở 3 ô phía trên.</div>"
        .. "\n<div fontcolor=#ffd45c>• </div><div fontcolor=#ffffff>Bấm vào từng ô kết quả để xem thông tin trang bị có thể nhận được.</div>"
        .. "\n<div fontcolor=#ffb95e>Lưu ý:</div><div fontcolor=#ffffff> Sau khi chế tạo thành công, nguyên liệu sẽ bị trừ ngay và trang bị mới được đưa vào túi đồ.</div>"
    )
end

